# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Store every text file as LF, and check it out as LF on every platform. Git for Windows installs
# core.autocrlf=true, which lands the working tree as CRLF -- and Pint's line_ending fixer then
# reports every file it checks as a style failure, which CI never sees because the pint job runs on
# ubuntu. So the documented local gate is red on a Windows checkout and green in CI, which is the
# worst way round. text=auto leaves anything Git detects as binary alone; nothing binary is tracked
# here today.
#
# This changes no file content: all 233 tracked blobs are already LF, because core.autocrlf has
# been normalising on the way in. It changes what a checkout writes to disk.
* text=auto eol=lf

# Keep development-only files out of the archive Composer installs from.
/.claude            export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.github            export-ignore
/.gitignore         export-ignore
/CLAUDE.md          export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/resources/css      export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/rector.php         export-ignore
/tests              export-ignore
